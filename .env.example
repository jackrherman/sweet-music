# Spotify app credentials - https://developer.spotify.com/dashboard
# The redirect URI must be allowlisted in the dashboard exactly as written here.
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional. Base URL of your Nightscout site, no trailing slash.
# Omit this and the glucose screen is skipped entirely.
NIGHTSCOUT_URL=https://your-nightscout-site.example.com
